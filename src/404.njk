---
permalink: /404.html
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta content="text/html; charset=utf-8" http-equiv="content-type">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link rel="icon" href="/img/profile/applepark-2026-circle.png" type="image/png">

    <title>404 - Page Not Found | Alessio Rubicini</title>
    <meta content="Alessio Rubicini" property="og:site_name">
    <meta content="Page not found." name="description">
    <meta content="website" property="og:type">
    <meta name="author" content="Alessio Rubicini"/>

    <link rel="canonical" href="https://alessiorubicini.github.io/404"/>
    <link rel="stylesheet" href="/styles.css">
    <style>
      .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: calc(var(--lineHeight) * 4) 0;
      }

      .error-code {
        font-size: calc(var(--fontSize) * 6);
        line-height: calc(var(--lineHeight) * 4);
        color: var(--primaryText);
        font-weight: 600;
        margin-bottom: calc(var(--lineHeight) * 1);
        font-feature-settings: "ss06" 1;
      }

      .error-message {
        font-size: calc(var(--fontSize) * 1.5);
        line-height: calc(var(--lineHeight) * 1.5);
        color: var(--secondaryText);
        margin-bottom: calc(var(--lineHeight) * 2);
        max-width: 40ch;
      }

      .error-description {
        color: var(--tertiaryText);
        margin-bottom: calc(var(--lineHeight) * 2);
        max-width: 50ch;
      }

      .error-links {
        display: flex;
        flex-direction: column;
        gap: calc(var(--lineHeight) / 2);
        align-items: center;
      }

      .error-links nav {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--lineHeight) / 4);
        justify-content: center;
        align-items: center;
      }

      .error-links a {
        color: var(--primaryText);
        text-decoration: underline;
        text-decoration-thickness: var(--hairlineThickness);
        text-underline-offset: 2px;
        text-decoration-color: color(from var(--primaryText) srgb r g b / 0.5);
      }

      .error-links a:hover {
        text-decoration-color: var(--accentColor);
      }

      @media screen and (max-width: 799px) {
        .error-code {
          font-size: calc(var(--fontSize) * 4);
          line-height: calc(var(--lineHeight) * 3);
        }

        .error-message {
          font-size: calc(var(--fontSize) * 1.2);
          line-height: calc(var(--lineHeight) * 1.2);
        }
      }
    </style>
  </head>
  <body>
    <script src="/animations.js"></script>
    <header class="vcard">
		<img id="avatar" data-appear src="/img/profile/applepark-2026-circle.png" width="44" height="44" alt="My Avatar">
		<div>
			<h1 class="fn font-editorial heading-editorial" data-appear>Hi, I'm Alessio Rubicini!</h1>
			<p data-appear style="margin-top: 0.3em;">I'm an iOS Developer with 5+ years building open source and shipping on the App Store. Swift Student Challenge winner at WWDC25. I push Apple platforms to their limits, from on-device AI to cryptographic security, always with the same obsession for native feel and detail. Currently based in Italy 🇮🇹🇪🇺 but always looking for opportunities somewhere else.</p>
			<p data-appear style="margin-top: 1em;"><a href="/mission">Curious about why I build?</a></p>
		</div>
	</header>
	{% include "sidebar.njk" %}
    <main>
      <div class="error-container">
        <div class="error-code" data-delay style="--delay: 2.0;">404</div>
        <h2 class="error-message" data-delay style="--delay: 2.2;">Page Not Found</h2>
        <p class="error-description" data-delay style="--delay: 2.4;">
          The page you're looking for doesn't exist or has been moved.
        </p>
      </div>
    </main>

    <footer data-delay>
    </footer>
  </body>
</html>
