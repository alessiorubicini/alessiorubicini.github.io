---
layout: base.njk
ogType: article
---
<main>
  <article class="post-article" data-appear>

    <header class="post-header" data-appear>
      <nav class="post-back" aria-label="Back to home">
        <a href="/">&larr; back</a>
      </nav>

      <h1 class="post-title">{{ title }}</h1>

      <div class="post-meta">
        <div class="post-author">
          <img src="/img/me-applepark2.png" alt="Alessio Rubicini" class="author-avatar">
          <span class="author-name">Alessio Rubicini</span>
        </div>
        <span class="post-meta-sep">·</span>
        <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
        <span class="post-meta-sep">·</span>
        <span class="reading-time">{{ content | readingTime }} min read</span>
      </div>

      {% if tags %}
      <div class="post-tags">
        {% for tag in tags %}
          {% if tag != "posts" %}
          <span class="tag-pill">{{ tag }}</span>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </header>

    <div class="post-content" data-appear>
      {{ content | safe }}
    </div>

    <div class="post-share" data-appear>
      <button class="share-button" onclick="shareArticle()" aria-label="Share this article">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Share
      </button>
      <span class="share-feedback" id="shareFeedback" aria-live="polite"></span>
    </div>

  </article>

  <div class="legal-links" data-appear>
    <span>© 2026 <a href="/">Alessio Rubicini</a></span>
  </div>
</main>
