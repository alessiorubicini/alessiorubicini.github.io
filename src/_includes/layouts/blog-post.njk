---
layout: base.njk
ogType: article
---
<main>
  <article class="post-article" data-appear>

    <header class="post-header" data-appear>
      

      <h1 class="post-title font-editorial article-title">{{ title }}</h1>

      <div class="post-meta">
        <div class="post-author">
          <img src="/img/IMG_7799.png" alt="Alessio Rubicini" class="author-avatar">
          <span class="author-name">Alessio Rubicini</span>
        </div>
        <span class="post-meta-sep">·</span>
        <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
        <span class="post-meta-sep">·</span>
        <span class="reading-time">{{ content | readingTime }} min read</span>
      </div>
    </header>

    <div class="post-content" data-appear>
      {{ content | safe }}
    </div>

    {% if tags %}
    <div class="post-tags" data-appear style="margin-top: calc(var(--lineHeight) * 1.5);">
      {% for tag in tags %}
        {% if tag != "posts" %}
        <span class="tag-pill">{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="post-share" data-appear>
      <button class="share-button" onclick="shareArticle()" aria-label="Share this article">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Share
      </button>
      <span class="share-feedback" id="shareFeedback" aria-live="polite"></span>
    </div>

    <div class="vcard post-author-footer" data-appear style="margin-top: calc(var(--lineHeight) * 2.5);">
      <img id="avatar" src="/img/IMG_7799.png" width="44" height="44" alt="Alessio Rubicini">
      <div>
        <h3 class="font-editorial" style="color: var(--primaryText); font-size: calc(var(--fontSize) * 1.35); font-weight: 500; letter-spacing: -0.01em; margin-bottom: 0.3em; line-height: 1.2;">Alessio Rubicini</h3>
        <p style="font-size: var(--secondaryFontSize); line-height: 1.6; margin: 0; color: var(--secondaryText); text-wrap: pretty;">I'm an iOS developer with 5+ years building open source and shipping on the App Store. Swift Student Challenge winner at WWDC25. I push Apple platforms to their limits, from on-device AI to cryptographic security, always with the same obsession for native feel and detail.</p>
      </div>
    </div>

  </article>

  <div class="legal-links" data-appear>
    <span>© 2026 <a href="/">Alessio Rubicini</a>. All rights reserved.</span>
  </div>
</main>
